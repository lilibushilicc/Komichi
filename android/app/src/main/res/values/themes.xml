<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (dark reading style) -->
    <style name="Theme.Komichi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ct_background</item>
        <item name="android:statusBarColor">@color/ct_background</item>
        <item name="android:navigationBarColor">@color/ct_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.Komichi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ct_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Komichi</item>
    </style>
</resources>
