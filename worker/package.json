{
  "name": "komichi-worker",
  "version": "2.0.0",
  "description": "Komichi Cloudflare Worker backend - private manga tracking system",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute komichi --file=./schema.sql",
    "db:seed": "wrangler d1 execute komichi --file=./init.sql",
    "db:create": "wrangler d1 create komichi",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.114.0"
  }
}
