# 复制为 crawler.env 并填写实际值
# systemd service 会通过 EnvironmentFile 加载这个文件
# 也可以不用 env 文件，改用 config.json（见 config.example.json）

KOMICHI_WORKER_URL=https://komichi-worker.xxx.workers.dev
KOMICHI_USERNAME=crawler
KOMICHI_PASSWORD=crawler123

# 可选覆盖（不填用默认值）
# KOMICHI_PLAYWRIGHT_TIMEOUT=45000
# KOMICHI_TIMEOUT=60
# KOMICHI_MAX_RETRIES=3
# KOMICHI_LOG_FILE=/opt/komichi-crawler/logs/crawler.log
# KOMICHI_STATE_FILE=/opt/komichi-crawler/logs/state.json
