<Window x:Class="Komichi.Desktop.Views.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Komichi.Desktop.Converters"
        xmlns:views="clr-namespace:Komichi.Desktop.Views"
        Title="阅读器"
        Width="900" Height="640"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </Window.Resources>

    <!-- 外层圆角容器 -->
    <Border x:Name="WindowChrome" CornerRadius="12" Background="{StaticResource BgBaseBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <views:CustomTitleBar x:Name="TitleBar" Grid.Row="0"/>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Background="{StaticResource BgBaseBrush}">
                <!-- 加载中 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Border Width="64" Height="64" CornerRadius="18"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BrandBrush}" BorderThickness="1">
                        <TextBlock Text="K" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar Width="160" Height="4" IsIndeterminate="True" Margin="0,20,0,0"/>
                    <TextBlock Text="加载章节中..." FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- 章节信息 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="48"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Border Width="52" Height="52" CornerRadius="14"
                            Background="{StaticResource BrandContainerBrush}" Margin="0,0,0,16"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentChapter.ChapterNum}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentChapter.DisplayName}" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="阅读追踪模式：打开章节即自动同步进度到服务器，跨设备继续阅读。"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,18,0,0" LineHeight="20"/>
                </StackPanel>

                <!-- 状态消息 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Background="{StaticResource BrandContainerBrush}"
                        CornerRadius="12" Padding="14,8" Margin="0,0,0,20"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource BrandBrush}"/>
                </Border>
            </Grid>

            <!-- 底部导航 -->
            <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="◀ 上一话" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PrevCommand}" Height="38" Padding="18,0"/>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource BgMenuBrush}" CornerRadius="14" Padding="16,6">
                        <TextBlock Text="{Binding PositionText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <Button Grid.Column="2" Content="下一话 ▶" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextCommand}" Height="38" Padding="18,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
