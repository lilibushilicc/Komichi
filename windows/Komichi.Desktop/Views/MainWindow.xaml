<Window x:Class="Komichi.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Komichi.Desktop.Converters"
        xmlns:vm="clr-namespace:Komichi.Desktop.ViewModels"
        xmlns:views="clr-namespace:Komichi.Desktop.Views"
        Title="Komichi"
        Width="1120" Height="740"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToPlaceholderConverter x:Key="NullToPlaceholder"/>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
        <conv:NullCoverToVisibilityConverter x:Key="NullCoverToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>

        <!-- 作品卡片模板（书架 + 记录共用） -->
        <DataTemplate x:Key="WorkCardTemplate" DataType="{x:Type vm:WorkItemViewModel}">
            <Border Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="14"
                    Margin="9"
                    Cursor="Hand"
                    BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                    MouseLeftButtonUp="WorkCard_OnMouseLeftButtonUp"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="12">
                    <!-- 封面 -->
                    <Grid Width="148" Height="200" ClipToBounds="True">
                        <Border Background="{StaticResource BgMenuBrush}" CornerRadius="10"/>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Cover}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <!-- 无封面占位 -->
                        <Border Background="{StaticResource BgElevatedBrush}" CornerRadius="10"
                                Visibility="{Binding Cover, Converter={StaticResource NullCoverToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📕" FontSize="40" HorizontalAlignment="Center"/>
                                <TextBlock Text="暂无封面" FontSize="11"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- 状态徽章（品牌绿=连载中 / 琥珀=已完结） -->
                        <Border Background="{Binding Work.Status, Converter={StaticResource StatusToBrush}}"
                                CornerRadius="11" Padding="9,3" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                        <!-- 阅读进度标记 -->
                        <Border Background="#CC0C0C0D" CornerRadius="8" Padding="7,2" Margin="8"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Visibility="{Binding ProgressText, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                       Foreground="{StaticResource BrandBrush}"/>
                        </Border>
                    </Grid>

                    <!-- 标题 -->
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Margin="2,10,2,0" MaxWidth="144" TextTrimming="CharacterEllipsis"/>

                    <!-- 副标题 -->
                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="2,5,2,0" MaxWidth="144" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 外层圆角容器 -->
    <Border x:Name="WindowChrome" CornerRadius="12" Background="{StaticResource BgBaseBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <views:CustomTitleBar x:Name="TitleBar" Grid.Row="0"/>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="24,8,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：视图切换 + 刷新 + 用户 -->
                <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}"
                        CornerRadius="12" Padding="16,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 用户信息 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14"
                                    Background="{StaticResource BrandContainerBrush}">
                                <TextBlock Text="{Binding Username, Converter={StaticResource NullToPlaceholder}, ConverterParameter=U}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource BrandBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="26"/>
                            </Border>
                            <TextBlock Text="{Binding Username}" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding ViewToggleText}" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ToggleViewCommand}" Margin="0,0,10,0" Height="34"/>
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshCommand}" Margin="0,0,10,0" Height="34"/>
                            <Button Content="退出登录" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding LogoutCommand}" Height="34"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 导入栏 -->
                <Border Grid.Row="1" Background="{StaticResource BgSurfaceBrush}"
                        CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="导入作品（源站 URL）:" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding ImportUrl, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Height="34"/>
                        <Button Grid.Column="2" Content="导入" Command="{Binding ImportCommand}"
                                Margin="10,0,0,0" Height="34" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 作品网格（书架） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding WorksVisibility}">
                    <ItemsControl ItemsSource="{Binding Works}"
                                  ItemTemplate="{StaticResource WorkCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 阅读记录网格 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding BookmarksVisibility}">
                    <ItemsControl ItemsSource="{Binding Bookmarks}"
                                  ItemTemplate="{StaticResource WorkCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 状态栏 -->
                <Border Grid.Row="3" Background="{StaticResource BgSurfaceBrush}" CornerRadius="10"
                        Padding="14,10" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,0,10,0"
                                 VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#32F08C"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="18,0,0,0"/>
                        <ProgressBar Grid.Column="2" Width="90" Height="4" IsIndeterminate="True"
                                     Margin="12,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
