<UserControl x:Class="Komichi.Desktop.Views.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="40">
    <Border Background="{StaticResource BgSurfaceBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 品牌标识 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="18" Height="18" Background="{StaticResource BrandBrush}"
                        CornerRadius="5">
                    <TextBlock Text="K" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource OnBrandBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Komichi" FontSize="13" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 窗口按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinBtn" Width="44" Height="40" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        Click="Minimize_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <Path Data="M0,6 L10,6" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="MaxBtn" Width="44" Height="40" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        Click="Maximize_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <Path x:Name="maxPath" Data="M1,3 L9,3 L9,11 L1,11 Z"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#26FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CloseBtn" Width="44" Height="40" Cursor="Hand"
                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        Click="Close_OnClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}">
                                <Path x:Name="closePath" Data="M1,1 L9,9 M9,1 L1,9"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource ErrorBrush}"/>
                                    <Setter TargetName="closePath" Property="Stroke" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
