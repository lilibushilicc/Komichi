<Window x:Class="Komichi.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Komichi.Desktop.Views"
        Title="Komichi · 登录"
        Width="400" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
    </Window.Resources>

    <!-- 外层圆角容器（自定义无边框窗口的底） -->
    <Border x:Name="WindowChrome" CornerRadius="14" Background="{StaticResource BgBaseBrush}"
            BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <views:CustomTitleBar x:Name="TitleBar" Grid.Row="0"/>

            <Grid Grid.Row="1" Margin="36,8,36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo / 标题 -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,14,0,24">
                    <Border Width="56" Height="56" CornerRadius="16"
                            Background="{StaticResource BrandContainerBrush}"
                            BorderBrush="{StaticResource BrandBrush}" BorderThickness="1.5"
                            HorizontalAlignment="Center">
                        <TextBlock Text="K" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Komichi" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>
                    <TextBlock Text="漫画阅读追踪 · Windows 桌面端" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Worker 地址 -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="Worker 地址" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="WorkerUrlBox" Height="38"
                             Text="{Binding WorkerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 用户名 -->
                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox" Height="38"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 密码 -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Height="38"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"/>
                </StackPanel>

                <!-- 状态消息 -->
                <TextBlock Grid.Row="4" Text="{Binding StatusMessage}"
                           FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#B8860B"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 登录按钮 -->
                <Button Grid.Row="5" Content="登 录" Height="44" FontSize="15" Margin="0,18,0,0"
                        Command="{Binding LoginCommand}"/>

                <!-- 提示 -->
                <TextBlock Grid.Row="6" VerticalAlignment="Bottom" TextWrapping="Wrap"
                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"
                           LineHeight="17"
                           Text="登录信息仅保存在本机 %AppData%\Komichi\config.json。默认账号：admin / admin123（需先部署 Worker 并执行 /api/auth/init）。"/>
            </Grid>
        </Grid>
    </Border>
</Window>
